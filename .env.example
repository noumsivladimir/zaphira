# ===============================
# Configuration Zaphira - Variables d'Environnement
# Copiez ce fichier vers .env et remplacez les valeurs
# ===============================

# ===============================
# Twilio SMS Configuration
# ===============================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ===============================
# Infrastructure Configuration
# ===============================
DB_HOST=192.168.100.4
DB_PORT=5432
KAFKA_BOOTSTRAP=192.168.100.4:9092

# ===============================
# Database Configuration
# ===============================
USER_DB_NAME=zaphira_users_db
USER_DB_USER=zaphira_user_service
USER_DB_PASSWORD=your_secure_password

AUTH_DB_NAME=zaphira_auth_db
AUTH_DB_USER=zaphira_auth_service
AUTH_DB_PASSWORD=your_secure_password

WALLET_DB_NAME=zaphira_wallets_db
WALLET_DB_USER=zaphira_wallet_service
WALLET_DB_PASSWORD=your_secure_password

TRANSACTION_DB_NAME=zaphira_transactions_db
TRANSACTION_DB_USER=zaphira_transaction_service
TRANSACTION_DB_PASSWORD=your_secure_password

NOTIFICATION_DB_NAME=zaphira_notifications_db
NOTIFICATION_DB_USER=zaphira_notification_service
NOTIFICATION_DB_PASSWORD=your_secure_password

# ===============================
# Email Configuration
# ===============================
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_app

# ===============================
# JWT Configuration
# ===============================
JWT_SECRET=votre_cle_secrete_jwt_tres_longue_et_complexe
JWT_ACCESS_EXPIRATION=100000
JWT_REFRESH_EXPIRATION=2592000000

# ===============================
# Telegram Bot Configuration
# ===============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===============================
# Kafka Configuration
# ===============================
KAFKA_ENABLED=true