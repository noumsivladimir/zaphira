# Exemple de configuration .env pour Zaphira
# Copiez ce fichier vers .env et remplacez les valeurs

# Twilio Configuration (PRODUCTION - utilisez des variables d'environnement)


# Email Configuration
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_app

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zaphira_db
SPRING_DATASOURCE_USERNAME=zaphira_user
SPRING_DATASOURCE_PASSWORD=secure_password

# JWT Configuration
JWT_SECRET=votre_cle_secrete_jwt_tres_longue_et_complexe
JWT_EXPIRATION=86400000

# Kafka Configuration (si activé)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=zaphira-group