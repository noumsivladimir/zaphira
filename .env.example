# Twilio Configuration (PRODUCTION - utilisez des variables d'environnement)
TWILIO_ACCOUNT_SID=AC4ee2203ca9ee74fe8df3010675a03cd2
TWILIO_AUTH_TOKEN=c94f6cac374ebe85351766659a3ced4b
TWILIO_FROM_NUMBER=+17177897813

# Email Configuration
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_app

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zaphira_db
