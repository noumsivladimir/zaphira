    "springBootVersion": "3.3.4",
    "postgresqlJdbcVersion": "42.7.3"
  },
  "issues": [
    {
      "severity": "🔴 High",
      "topic": "Orphaned Topic: transaction.validation.request",
      "description": "transaction-service publishes to transaction.validation.request but no consumer is found",
      "impact": "Messages accumulate in Kafka without processing",
      "recommendation": "Find or implement the missing consumer service"
    },
    {
      "severity": "🔴 High",
      "topic": "Database URL Mismatch",
      "description": "wallet-service uses localhost:5432 while other services use 192.168.0.122:5432",
      "impact": "Potential data inconsistency across services",
      "recommendation": "Align all database URLs to use same host"
    },
    {
      "severity": "🟡 Medium",
      "topic": "Missing Producers",
      "description": "notification-service has 5 consumers but no producers",
      "impact": "Cannot trigger notifications from notification-service",
      "recommendation": "Implement producer for notification events"
    },
    {
      "severity": "🟡 Medium",
      "topic": "DDL Strategy Inconsistency",
      "description": "Mixed DDL strategies: create-drop vs update vs validate",
      "impact": "Data loss risk on restart, difficult debugging",
      "recommendation": "Use 'update' strategy for all production databases"
    },
    {
      "severity": "🟡 Medium",
      "topic": "Unknown Topic Producers",
      "description": "Topics notification.*.events and transaction-created have no identified producer",
      "impact": "Unclear data flow, potential dead code",
      "recommendation": "Search codebase for missing producers or remove topics"
    }
  ],
  "recommendations": {
    "immediate": [
      "Identify consumer for transaction.validation.request topic",
      "Align PostgreSQL URLs (192.168.0.122 vs localhost)",
      "Centralize topic configuration in property file"
    ],
    "shortTerm": [
      "Implement missing producers for notification.*.events",
      "Use consistent DDL strategy (update for all)",
      "Add retry and DLQ policies to all consumers"
    ],
    "mediumTerm": [
      "Implement Kafka security (SSL/SASL)",
      "Add Kafka monitoring and metrics",
      "Document event schema and contracts",
      "Implement distributed tracing (correlation IDs)"
    ]
  }
